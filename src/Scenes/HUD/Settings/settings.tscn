mouse_filter = 2
bbcode_enabled = true
text = "[color=#ffd166][b]CONTROLS[/b][/color]

A / D — Move
Space — Jump
Mouse — Aim
Hold right click / J — Mine or attack
Left click — Place or use the selected item
Q / E — Change hotbar slot
F — Drop one selected item
Esc — Pause
Ctrl + M — Mute / unmute


[color=#ffd166][b]WEAPONS[/b][/color]

Click the weapon icon to select an unlocked weapon.

Pickaxe — Instantly mines dirt.
Axe — Instantly breaks vegetation.
Bow — Hold right click to aim, release to shoot.


[color=#ffd166][b]CRAFTING & QUESTS[/b][/color]

Click the backpack to open Crafting and Quests.

Hover over a recipe to see its ingredients.
Click a recipe with a golden outline to craft it.

Open Quests to see your current objectives."
fit_content = true
scroll_active = false

